GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=
# Optional ordered key pool (comma-separated); if set, takes precedence over GEMINI_API_KEY.
# Keys in the same Google Cloud project share quota. Blank keeps the single-key setup.
GEMINI_API_KEYS=
# Optional separate model for itinerary generation; blank uses GEMINI_MODEL.
GEMINI_ITINERARY_MODEL=gemini-3.5-flash-lite
# Blank uses minimal for Gemini 3 Flash-Lite, low for other Gemini 3 models.
GEMINI_ITINERARY_THINKING_LEVEL=
# Public Data Portal: decoded service key for Korean tourism information.
TOUR_API_KEY=
# Geoapify project API key for overseas search and recommendations (Places API).
GEOAPIFY_API_KEY=
# Optional Unsplash Access Key for overseas region covers (server-side only).
UNSPLASH_ACCESS_KEY=
# Legacy experimental translator only; place-name display does not use it.
LIBRETRANSLATE_URL=http://127.0.0.1:5000
# true explicitly enables sample itineraries, not AI-generated output.
DEMO_MODE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Public beta request safeguards. Counters persist in API_LIMIT_DB (UTC day).
API_REQUESTS_PER_MINUTE=60
AI_REQUESTS_PER_MINUTE=5
API_REQUESTS_PER_DAY=2000
AI_REQUESTS_PER_DAY=200
API_MAX_CONCURRENT=8
API_MAX_BODY_BYTES=131072
# Optional persistent paths. Blank uses the project's ignored .tools directory.
DESTINATION_DB=
API_LIMIT_DB=
MAP_TRANSLATION_CACHE=

# Optional selected-region flight quotes (server-side only).
SERPAPI_API_KEY=
# App-wide monthly external requests; a successful round-trip lookup uses 2.
SERPAPI_MONTHLY_SEARCH_LIMIT=200
FLIGHT_REQUESTS_PER_MINUTE=3
